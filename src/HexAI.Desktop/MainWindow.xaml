<Window x:Class="HexAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HexAI" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    
<Border CornerRadius="12" Background="{StaticResource BgDark}" BorderBrush="#374151" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" /> <!-- Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource BgVeryDark}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title / Window Controls -->
                        <RowDefinition Height="Auto"/> <!-- Model Selector -->
                        <RowDefinition Height="Auto"/> <!-- New Chat -->
                        <RowDefinition Height="*"/>    <!-- History -->
                        <RowDefinition Height="Auto"/> <!-- Evaluation Buttons -->
                        <RowDefinition Height="Auto"/> <!-- User Settings -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="HexAI Workspace" Foreground="{StaticResource TextLight}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="v2.0 (LargeGPT + LLM)" Foreground="{StaticResource TextDark}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Model Selector -->
                    <Border Grid.Row="1" Background="{StaticResource BgLighter}" CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🌐 Aktif Model" Foreground="{StaticResource TextDark}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <ComboBox x:Name="ModelSelector" Background="{StaticResource BgHover}" Foreground="{StaticResource TextLight}" 
                                      BorderThickness="0" FontSize="12" Padding="6,4"
                                      SelectionChanged="ModelSelector_SelectionChanged">
                                <ComboBoxItem Content="🤖 HexAI Standart" Tag="Standard" IsSelected="True"/>
                                <ComboBoxItem Content="🎭 Yaratıcı Mod" Tag="Creative"/>
                                <ComboBoxItem Content="💻 Kodlayıcı" Tag="Coder"/>
                                <ComboBoxItem Content="🧙‍♂️ Rol Yapma" Tag="Roleplay"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2" Content="+ Yeni Sohbet" Style="{StaticResource SidebarButton}" FontSize="14" Margin="0,0,0,15" Foreground="{StaticResource TextLight}" BorderBrush="{StaticResource BgHover}" BorderThickness="1" Click="NewChatButton_Click" />

                    <!-- History List -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Geçmiş Sohbetler" Foreground="{StaticResource TextDark}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ListBox x:Name="SessionList" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="SessionList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgHover}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BgHover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" Foreground="{StaticResource TextLight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Grid.Column="1" Content="🗑️" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDark}" FontSize="12" ToolTip="Sohbeti Sil" Click="DeleteSession_Click" Cursor="Hand" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Evaluation Buttons (Ayarlar üstünde) -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,5">
                        <TextBlock Text="🧪 Değerlendirme &amp; Oyunlar" Foreground="{StaticResource TextDark}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button Content="🎮  Oyunlar &amp; Kararlılık Testi" Style="{StaticResource SidebarButton}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,1" Click="MiniGames_Click" ToolTip="Yapay zekanın rastgele labirent ve mantık oyunlarındaki zaman kararlılığı, doğruluk ve hata oranını ölçer" />
                        <Button Content="🧪  Eğitim Testi" Style="{StaticResource SidebarButton}" FontSize="12" Margin="0,1" Click="EvaluationTest_Click" ToolTip="Eğitilmiş modelin öğrenip öğrenmediğini test eder" />
                        <Button Content="📊  Tutarlılık Raporu" Style="{StaticResource SidebarButton}" FontSize="12" Margin="0,1" Click="ConsistencyReport_Click" ToolTip="Son test sonuçlarının detaylı raporunu gösterir" />
                        <Button Content="⚡  Benchmark" Style="{StaticResource SidebarButton}" FontSize="12" Margin="0,1" Click="Benchmark_Click" ToolTip="Standart sorularla modeli test eder" />
                        <Button Content="📚  Bilgi Tabanı" Style="{StaticResource SidebarButton}" FontSize="12" Margin="0,1" Click="KnowledgeBase_Click" ToolTip="Doğrulanmış bilgi tabanı istatistikleri" />
                        <Button Content="📤  Sohbeti Dışa Aktar" Style="{StaticResource SidebarButton}" FontSize="12" Margin="0,1" Click="ExportChat_Click" ToolTip="Aktif sohbeti Markdown olarak masaüstüne kaydeder" />
                    </StackPanel>

                    <!-- Profile / Settings -->
                    <Border Grid.Row="5" BorderBrush="{StaticResource BgHover}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <Button Content="⚙️  Ayarlar ve Profil" Style="{StaticResource SidebarButton}" Click="SettingsButton_Click" />
                            <!-- Token Counter -->
                            <TextBlock x:Name="TokenCounter" Text="🪙 Token: 0" Foreground="{StaticResource TextDark}" FontSize="10" Margin="10,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Custom Title Bar Area for Dragging -->
                    <RowDefinition Height="*"/>  <!-- Chat List -->
                    <RowDefinition Height="120"/> <!-- Input Area -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar (Right Side) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <!-- Provider Badge (sol taraf) -->
                    <TextBlock x:Name="ProviderBadge" Text="🤖 Otomatik" Foreground="{StaticResource TextDark}" FontSize="11" 
                               VerticalAlignment="Center" Margin="15,0,0,0" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Width="40" Background="Transparent" Foreground="{StaticResource TextDark}" BorderThickness="0" FontSize="14" Click="MinimizeButton_Click"/>
                        <Button Content="✕" Width="40" Background="Transparent" Foreground="{StaticResource TextDark}" BorderThickness="0" FontSize="14" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Chat Scroll Area -->
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" Margin="0" Padding="40,10">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Astra.ai style: Avatar on left, text flowing on right -->
                                <Grid Margin="0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" 
                                            Background="{Binding AvatarBackground}">
                                        <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="White" />
                                    </Border>
                                    
                                    <!-- Name and Text -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Author}" Foreground="{StaticResource TextLight}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextLight}" TextWrapping="Wrap" FontSize="15" LineHeight="24" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <TextBlock x:Name="LoadingIndicator" Grid.Row="1" Text="AI Motoru Başlatılıyor..." 
                           Foreground="{StaticResource AccentColor}" FontSize="14" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" />

                <!-- Input Area (Centered, Floating style) -->
                <Grid Grid.Row="2" Margin="40,10,40,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="800" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" HorizontalAlignment="Center" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" 
                            Style="{StaticResource GlassBorder}" Padding="10" Background="{StaticResource BgLighter}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Voice Button (Kaldırıldı) -->
                            <Button x:Name="VoiceButton" Grid.Column="0" Content="🎙️" Width="0" Height="0" 
                                    Visibility="Collapsed" IsEnabled="False" />
                            
                            <!-- Text Input -->
                            <TextBox x:Name="InputBox" Grid.Column="1" Padding="15,10" 
                                     Background="Transparent" Foreground="{StaticResource TextLight}" 
                                     BorderThickness="0" FontSize="15" VerticalAlignment="Center"
                                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80" 
                                     KeyDown="InputBox_KeyDown" IsEnabled="False" />
                            
                            <!-- Send Button -->
                            <Button x:Name="SendButton" Grid.Column="2" Content="⬆" Width="40" Height="40" 
                                    Style="{StaticResource AccentButton}" FontSize="20" FontWeight="Bold" 
                                    Click="SendButton_Click" IsEnabled="False" Cursor="Hand" />
                        </Grid>
                    </Border>
                    
                    <TextBlock Text="HexAI hata yapabilir. Önemli bilgileri kontrol edin." Foreground="{StaticResource TextDark}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
