<Window x:Class="HexAI.Desktop.MiniGamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HexAI Bilişsel Oyunlar &amp; Kararlılık Test Laboratuvarı" 
        Height="780" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{StaticResource BgDark}" BorderBrush="#374151" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR -->
            <Grid Grid.Row="0" Background="{StaticResource BgVeryDark}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🎮 HexAI Bilişsel Oyunlar &amp; Kararlılık Test Laboratuvarı" 
                               Foreground="{StaticResource TextLight}" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="— (Time Stability, Doğruluk ve Hata Oranı Analizi)" 
                               Foreground="{StaticResource TextDark}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
                    <Button Content="—" Width="40" Background="Transparent" Foreground="{StaticResource TextDark}" BorderThickness="0" FontSize="14" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Width="40" Background="Transparent" Foreground="{StaticResource TextDark}" BorderThickness="0" FontSize="14" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- MAIN BODY / TABS -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="12,8,12,12">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{StaticResource BgLighter}" />
                        <Setter Property="Foreground" Value="{StaticResource TextDark}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,8" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: RASTGELE LABİRENT VE AI ÇÖZÜCÜ -->
                <TabItem Header="🏰 Rastgele Labirent (Maze Stability)">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" /> <!-- Kontroller ve Metrikler -->
                            <ColumnDefinition Width="*" />   <!-- Görsel Labirent Canvas'ı -->
                        </Grid.ColumnDefinitions>

                        <!-- SOL PANEL: KONTROLLER & SKOR KARTLARI -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                            <StackPanel>
                                <!-- Kontrol Paneli -->
                                <Border Style="{StaticResource GlassBorder}" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Labirent Yapılandırması" Foreground="{StaticResource TextLight}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" />
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Labirent Boyutu:" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" FontSize="12" />
                                            <ComboBox x:Name="MazeSizeCombo" Grid.Column="1" Background="{StaticResource BgHover}" Foreground="{StaticResource TextLight}" Padding="6,3" FontSize="12">
                                                <ComboBoxItem Content="15 x 15 (Hızlı)" Tag="15"/>
                                                <ComboBoxItem Content="21 x 21 (Standart)" Tag="21" IsSelected="True"/>
                                                <ComboBoxItem Content="31 x 31 (Karmaşık)" Tag="31"/>
                                                <ComboBoxItem Content="41 x 41 (Dev)" Tag="41"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Test Tekrarı:" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" FontSize="12" />
                                            <ComboBox x:Name="MazeRunsCombo" Grid.Column="1" Background="{StaticResource BgHover}" Foreground="{StaticResource TextLight}" Padding="6,3" FontSize="12">
                                                <ComboBoxItem Content="1 (Tekli Görsel)" Tag="1" IsSelected="True"/>
                                                <ComboBoxItem Content="10x Kararlılık" Tag="10"/>
                                                <ComboBoxItem Content="25x Kararlılık" Tag="25"/>
                                                <ComboBoxItem Content="50x Derin Test" Tag="50"/>
                                            </ComboBox>
                                        </Grid>

                                        <Button x:Name="BtnRunMaze" Content="🎮  Labirenti Oluştur &amp; Çöz" Style="{StaticResource AccentButton}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" Click="BtnRunMaze_Click" Cursor="Hand" />
                                        <Button x:Name="BtnBatchStability" Content="⚡  Çoklu Kararlılık Testi Başlat (25x)" Style="{StaticResource SidebarButton}" Background="{StaticResource BgHover}" Foreground="{StaticResource TextLight}" FontSize="12" Click="BtnBatchStability_Click" Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <!-- METRİK SKOR KARTLARI (2x2 Grid) -->
                                <TextBlock Text="📊 Canlı Kararlılık ve Doğruluk Metrikleri" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" FontSize="11" Margin="2,0,0,6" />
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Kart 1: Zaman Kararlılığı -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgLighter}" CornerRadius="8" Padding="10" Margin="0,0,4,4">
                                        <StackPanel>
                                            <TextBlock Text="⏱️ Zaman Kararlılığı" Foreground="{StaticResource TextDark}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TxtTimeStability" Text="—" Foreground="{StaticResource AccentColor}" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                            <TextBlock x:Name="TxtTimeDetails" Text="Sapma (σ): —" Foreground="{StaticResource TextDark}" FontSize="10" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Kart 2: Doğruluk Oranı -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgLighter}" CornerRadius="8" Padding="10" Margin="4,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="🎯 Doğruluk Oranı" Foreground="{StaticResource TextDark}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TxtAccuracy" Text="—" Foreground="#10B981" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                            <TextBlock x:Name="TxtAccuracyDetails" Text="Hedefe Ulaşma" Foreground="{StaticResource TextDark}" FontSize="10" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Kart 3: Hata Oranı -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgLighter}" CornerRadius="8" Padding="10" Margin="0,4,4,0">
                                        <StackPanel>
                                            <TextBlock Text="❌ Hata Oranı" Foreground="{StaticResource TextDark}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TxtErrorRate" Text="—" Foreground="#EF4444" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                            <TextBlock x:Name="TxtErrorDetails" Text="Ölü nokta &amp; Geri adım" Foreground="{StaticResource TextDark}" FontSize="10" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Kart 4: Yol Verimliliği -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgLighter}" CornerRadius="8" Padding="10" Margin="4,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📏 Yol Verimliliği" Foreground="{StaticResource TextDark}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TxtEfficiency" Text="—" Foreground="#3B82F6" FontSize="20" FontWeight="Bold" Margin="0,4,0,2" />
                                            <TextBlock x:Name="TxtEfficiencyDetails" Text="Optimal / Atılan Adım" Foreground="{StaticResource TextDark}" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Çalıştırma Geçmişi Listesi -->
                                <Border Style="{StaticResource GlassBorder}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="📜 Çalıştırma Kayıtları" Foreground="{StaticResource TextLight}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                                        <ListBox x:Name="ListMazeHistory" Background="Transparent" BorderThickness="0" Height="190" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgHover}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Tag}" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,0,8,0" FontSize="11" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Content}" Foreground="{StaticResource TextLight}" FontSize="11" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ToolTip}" Foreground="{StaticResource TextDark}" FontSize="10" Margin="6,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- SAĞ PANEL: GÖRSEL LABİRENT TUVALİ -->
                        <Border Grid.Column="1" Style="{StaticResource GlassBorder}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Lejant (Açıklama) -->
                                    <RowDefinition Height="*"/>    <!-- Canvas -->
                                    <RowDefinition Height="Auto"/> <!-- Status Alt Metni -->
                                </Grid.RowDefinitions>

                                <!-- Lejant -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border Width="12" Height="12" Background="#10B981" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="Başlangıç (S)" Foreground="{StaticResource TextDark}" FontSize="11" Margin="0,0,16,0" />

                                    <Border Width="12" Height="12" Background="#EF4444" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="Hedef (G)" Foreground="{StaticResource TextDark}" FontSize="11" Margin="0,0,16,0" />

                                    <Border Width="12" Height="12" Background="#8B5CF6" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="AI Gezilen Yol" Foreground="{StaticResource TextDark}" FontSize="11" Margin="0,0,16,0" />

                                    <Border Width="12" Height="12" Background="#06B6D4" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="Optimal Yol" Foreground="{StaticResource TextDark}" FontSize="11" Margin="0,0,16,0" />

                                    <Border Width="12" Height="12" Background="#F59E0B" CornerRadius="2" Margin="0,0,4,0" />
                                    <TextBlock Text="Ölü Noktalar" Foreground="{StaticResource TextDark}" FontSize="11" />
                                </StackPanel>

                                <!-- Canvas Alanı -->
                                <Border Grid.Row="1" Background="{StaticResource BgVeryDark}" CornerRadius="8" BorderBrush="#374151" BorderThickness="1" ClipToBounds="True">
                                    <Viewbox Stretch="Uniform">
                                        <Canvas x:Name="MazeCanvas" Width="600" Height="600" Background="#0B0F19"/>
                                    </Viewbox>
                                </Border>

                                <!-- Durum Metni -->
                                <TextBlock x:Name="TxtMazeStatus" Grid.Row="2" Text="Labirent oluşturmak ve çözmek için 'Labirenti Oluştur &amp; Çöz' butonuna tıklayın." 
                                           Foreground="{StaticResource TextDark}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: SAYI DİZİSİ VE MANTIK ÖRÜNTÜSÜ OYUNU -->
                <TabItem Header="🧩 Sayı &amp; Mantık Dizisi (Pattern Benchmark)">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Kontroller ve Özet -->
                            <RowDefinition Height="*"/>    <!-- Problem Listesi -->
                        </Grid.RowDefinitions>

                        <!-- Üst Kart: Buton ve Metrikler -->
                        <Border Grid.Row="0" Style="{StaticResource GlassBorder}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🧩 Mantık &amp; Örüntü Kararlılık Testi" Foreground="{StaticResource TextLight}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                    <TextBlock Text="Aritmetik, Geometrik, Fibonacci, Karesel ve Dalgalı dizilerde yapay zekanın tümevarım yeteneğini ve zaman kararlılığını test eder." 
                                               Foreground="{StaticResource TextDark}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" />
                                    <Button x:Name="BtnRunSequenceTest" Content="🚀  Mantık Testini Çalıştır (20 Soru)" Style="{StaticResource AccentButton}" FontWeight="Bold" FontSize="12" Click="BtnRunSequenceTest_Click" Cursor="Hand" />
                                </StackPanel>

                                <!-- Metrik Özetleri -->
                                <Grid Grid.Column="1" Margin="20,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="8" Padding="8" Margin="0,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🎯 Doğruluk" Foreground="{StaticResource TextDark}" FontSize="10" />
                                            <TextBlock x:Name="TxtSeqAccuracy" Text="—" Foreground="#10B981" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource BgHover}" CornerRadius="8" Padding="8" Margin="4,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="❌ Hata Oranı" Foreground="{StaticResource TextDark}" FontSize="10" />
                                            <TextBlock x:Name="TxtSeqErrorRate" Text="—" Foreground="#EF4444" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource BgHover}" CornerRadius="8" Padding="8" Margin="4,0,4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⏱️ Ort. Süre" Foreground="{StaticResource TextDark}" FontSize="10" />
                                            <TextBlock x:Name="TxtSeqMeanTime" Text="—" Foreground="#3B82F6" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="{StaticResource BgHover}" CornerRadius="8" Padding="8" Margin="4,0,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="⏳ Zaman Kararlılığı" Foreground="{StaticResource TextDark}" FontSize="10" />
                                            <TextBlock x:Name="TxtSeqStability" Text="—" Foreground="{StaticResource AccentColor}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Problem Listesi -->
                        <Border Grid.Row="1" Style="{StaticResource GlassBorder}" Padding="12">
                            <ListBox x:Name="ListSequenceProblems" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgVeryDark}" CornerRadius="6" Padding="12,8" Margin="0,3" BorderBrush="#2D3748" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Tag}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayType}" FontWeight="Bold" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SequenceText}" Foreground="{StaticResource TextLight}" FontFamily="Consolas, monospace" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AnswerText}" Foreground="{StaticResource TextDark}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ElapsedText}" Foreground="{StaticResource TextDark}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: KAPSAMLI KARARLILIK RAPORU -->
                <TabItem Header="📊 Kapsamlı Kararlılık Raporu">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="⚡  Büyük Kararlılık Suite'i Çalıştır" Style="{StaticResource AccentButton}" FontWeight="Bold" Padding="14,8" Click="BtnRunFullReport_Click" Cursor="Hand" Margin="0,0,10,0"/>
                            <Button Content="📋  Raporu Kopyala" Style="{StaticResource SidebarButton}" Background="{StaticResource BgHover}" Foreground="{StaticResource TextLight}" Padding="12,8" Click="BtnCopyReport_Click" Cursor="Hand" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource GlassBorder}" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtFullReport" Background="Transparent" Foreground="{StaticResource TextLight}" 
                                         BorderThickness="0" FontFamily="Consolas, monospace" FontSize="12" 
                                         IsReadOnly="True" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
